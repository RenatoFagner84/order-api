const pedidosRepository = require("../repositories/pedidosRepository");

const pedidos = require("../controllers/pedidos");

const pedidosRoutes = async (req, res) => {
    const url = new URL(req.url, "http://localhost:3000");
    const partes = url.pathname.split("/");
    const id = Number(partes[2]);

    // Finalizar carrinho e criar pedido
    if (
        req.method === "POST" &&
        /^\/pedido\/\d+\/finalizar$/.test(url.pathname)
    ) {
        await pedidos.pedidosFinalizar(req, res);
        return;
    }

    // Criar pedido
    if (
        req.method === "POST" &&
        url.pathname === "/pedido"
    ) {
        let body = "";

        req.on("data", (chunk) => {
            body += chunk;
        });

        await new Promise((resolve) => {
            req.on("end", resolve);
        });

        const dados = JSON.parse(body);

        const pedido = await pedidosRepository.criar(
            Number(dados.user_id)
        );

        res.writeHead(201, {
            "Content-Type": "application/json"
        });

        res.end(JSON.stringify({
            mensagem: "Pedido criado com sucesso",
            pedido: pedido.rows[0]
        }));

        return;
    }

    // Consultar histórico de status
    if (
        req.method === "GET" &&
        partes.length === 4 &&
        partes[3] === "historico-status"
    ) {
        await pedidos.pedidosHistoricoStatus(req, res);
        return;
    }

    // Consultar pedido
    if (
        req.method === "GET" &&
        partes.length === 3 &&
        Number.isInteger(id) &&
        id > 0
    ) {
        const pedido = await pedidosRepository.consultar(id);

        if (pedido.rows.length === 0) {
            res.writeHead(404, {
                "Content-Type": "application/json"
            });

            res.end(JSON.stringify({
                mensagem: "Pedido não encontrado"
            }));

            return;
        }

        res.writeHead(200, {
            "Content-Type": "application/json"
        });

        res.end(JSON.stringify({
            pedido: pedido.rows[0]
        }));

        return;
    }

    // Fechar pedido
    if (
        req.method === "PATCH" &&
        partes.length === 4 &&
        partes[3] === "fechar"
    ) {
        const pedido = await pedidosRepository.atualizar(
            id,
            401
        );

        if (pedido.rows.length === 0) {
            res.writeHead(404, {
                "Content-Type": "application/json"
            });

            res.end(JSON.stringify({
                mensagem: "Pedido não encontrado"
            }));

            return;
        }

        res.writeHead(200, {
            "Content-Type": "application/json"
        });

        res.end(JSON.stringify({
            mensagem: "Pedido fechado com sucesso",
            pedido: pedido.rows[0]
        }));

        return;
    }

    // Atualizar status do pedido
    if (
        req.method === "PATCH" &&
        partes.length === 3 &&
        Number.isInteger(id) &&
        id > 0
    ) {
        let body = "";

        req.on("data", (chunk) => {
            body += chunk;
        });

        await new Promise((resolve) => {
            req.on("end", resolve);
        });

        const dados = JSON.parse(body);

        const pedido = await pedidosRepository.atualizar(
            id,
            dados.status
        );

        if (pedido.rows.length === 0) {
            res.writeHead(404, {
                "Content-Type": "application/json"
            });

            res.end(JSON.stringify({
                mensagem: "Pedido não encontrado"
            }));

            return;
        }

        res.writeHead(200, {
            "Content-Type": "application/json"
        });

        res.end(JSON.stringify({
            mensagem: "Pedido atualizado com sucesso",
            pedido: pedido.rows[0]
        }));

        return;
    }

    res.writeHead(404, {
        "Content-Type": "application/json"
    });

    res.end(JSON.stringify({
        mensagem: "Rota de pedido não encontrada"
    }));
};

module.exports = pedidosRoutes;
